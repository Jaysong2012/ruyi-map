{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Map Studio scene",
  "type": "object",
  "required": ["schemaVersion", "name", "bounds", "sources", "look", "shots", "output"],
  "properties": {
    "schemaVersion": {"const": 1},
    "name": {"type": "string", "minLength": 1},
    "bounds": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"type": "number"}},
    "sources": {
      "type": "object",
      "required": ["dem", "texture"],
      "properties": {
        "dem": {"$ref": "#/$defs/raster"},
        "texture": {"$ref": "#/$defs/raster"},
        "routes": {"type": "string"},
        "water": {"type": "string"}
      }
    },
    "look": {"type": "object", "required": ["preset"], "properties": {"preset": {"type": "string"}}},
    "shots": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["id", "kind", "cameraPreset"]}},
    "output": {
      "type": "object",
      "required": ["directory", "width", "height"],
      "properties": {
        "directory": {"type": "string"},
        "width": {"type": "integer", "minimum": 1},
        "height": {"type": "integer", "minimum": 1},
        "terrainGridMax": {"type": "integer", "minimum": 256, "maximum": 4096}
      }
    }
  },
  "$defs": {
    "raster": {
      "type": "object",
      "required": ["path", "format", "geoSidecar"],
      "properties": {
        "path": {"type": "string"},
        "format": {"enum": ["terrarium", "geotiff", "image"]},
        "geoSidecar": {"type": "string"}
      }
    }
  }
}
